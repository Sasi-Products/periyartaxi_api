NODE_ENV=development
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=periyar_taxi
DB_USER=root
DB_PASSWORD=
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173
DEFAULT_BRANCH_NAME=Erode
DEFAULT_BRANCH_LAT=11.3410
DEFAULT_BRANCH_LNG=77.7172
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SET_STRONG_PASSWORD_BEFORE_SEED
SUPER_ADMIN_MOBILE=
# Web/browser key needs domain restriction; server key restrict to Google Routes API/server IP
GOOGLE_MAPS_SERVER_KEY=
# Separate client key in frontend/.env
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# MSG91 Flow API (India) with DLT-approved SMS flow; leave empty to disable live sends
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=
# Firebase service account JSON file path; keep outside public web directory
FIREBASE_SERVICE_ACCOUNT_PATH=
OTP_DEV_MODE=true
OTP_TTL_MINUTES=5
LOCATION_STALE_SECONDS=120
DISPATCH_OFFER_SECONDS=45
DISPATCH_RADIUS_KM=20

# External GPS provider POST /api/telematics/ingest. Keep a random 32+ character token SERVER-SIDE ONLY.
# Set this only when a vehicle tracking device/provider is integrated.
VEHICLE_GPS_INGEST_TOKEN=
